# Server Configuration
PORT=5000
NODE_ENV=development

# Nodemailer / Gmail SMTP Configuration
# The recipient email where contact form submissions will be sent
RECIPIENT_EMAIL=craftlywebsolutions@gmail.com

# Gmail sender account credentials
# NOTE: For Gmail, use an App Password generated from:
# Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_USER=craftlywebsolutions@gmail.com
EMAIL_PASS=your_gmail_app_password_here
